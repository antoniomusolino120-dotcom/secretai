FROM mcr.microsoft.com/playwright/python:v1.52.0-noble
WORKDIR /srv
COPY requirements.lock.txt ./
RUN pip install --no-cache-dir -r requirements.lock.txt playwright==1.52.0
COPY app ./app
COPY migrations ./migrations
COPY alembic.ini ./
USER pwuser
CMD ["uvicorn","app.browser_worker:app","--host","0.0.0.0","--port","9020","--no-access-log"]
