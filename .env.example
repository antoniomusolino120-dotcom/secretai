# Local development; real secrets belong only in a private .env or secret manager.
SECRET_AI_ENV=development
SECRET_AI_PUBLIC_URL=http://localhost:8000
SECRET_AI_DB=./secretai.db

# Docker / production: independent PostgreSQL only. Percent-encode the URL password.
# SECRET_AI_DATABASE_URL=postgresql+psycopg://secretai:CHANGE_ME@db:5432/secretai
# SECRET_AI_POSTGRES_PASSWORD=CHANGE_ME
# SECRET_AI_DOMAIN=secretai.example.com
# SECRET_AI_PUBLIC_URL=https://secretai.example.com
# SECRET_AI_ENV=production

# Generate privately: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_AI_ENCRYPTION_KEY=
OLLAMA_URL=http://127.0.0.1:11434
# In Docker with --profile ai, use http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
SECRET_AI_AUTH_RATE_LIMIT=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
META_APP_SECRET=
META_VERIFY_TOKEN=
# Use the API version approved for your Meta app; no implicit upgrade.
META_GRAPH_VERSION=

# Email delivery: required for production registration, verification and recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Dedicated SecretAI Stripe account/sandbox credentials, restricted key preferred.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Decide plans and prices before configuring. No charges or product creation at setup.
SECRET_AI_PLANS_JSON={}
# Example shape only (supply real authorized price IDs):
# {"starter":{"price_id":"price_REPLACE","message_limit":1000,"voice_seconds_limit":3600}}
# Billing is enforced by default in production, disabled by default locally.
# SECRET_AI_BILLING_REQUIRED=1

# Private service plane: generate once with secrets.token_urlsafe(48).
SECRET_AI_INTERNAL_TOKEN=
SECRET_AI_API_INTERNAL_URL=http://api:8000

# Browser recording/execution: exact approved HTTPS origins, comma-separated.
BROWSER_WORKER_URL=http://browser:9020
BROWSER_ALLOWED_ORIGINS=
BROWSER_AUTH_ORIGINS=
BROWSER_MAX_SESSIONS=4
# Local fixture tests only; never enabled in production.
# BROWSER_ALLOW_LOCAL_TEST=1

# Voice service + selected provider/number (the latter require owner activation).
PIPER_MODEL=/srv/models/it_IT-paola-medium.onnx
WHISPER_MODEL=small
VOICE_MAX_SECONDS=900
VOICE_VAD_RMS=450
SECRET_AI_VOICE_ROUTE_ID=
SIP_FALLBACK_CHANNEL=PJSIP/operator

# Self-service Meta apps, after operator registration/approval.
META_APP_ID=
META_WHATSAPP_CONFIG_ID=
META_SIGNUP_EXTRAS_JSON={}
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/meta/oauth/instagram/callback

# Define retention according to the approved company/privacy policy. Zero disables purge.
SECRET_AI_RETENTION_DAYS=0
